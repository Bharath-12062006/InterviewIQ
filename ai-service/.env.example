# InterviewIQ Python AI Service Environment Configuration
AI_HOST=127.0.0.1
AI_PORT=8000
AI_SERVICE_KEY=

# Primary LLM Provider: "ollama" (local), "gemini", or "openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=150
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=300
OLLAMA_THINK=false
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT_SECONDS=45

# Optional cloud LLM provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional alternative LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=35

# Keep false in production so missing LLM keys are reported explicitly
ALLOW_NLP_FALLBACK=false
